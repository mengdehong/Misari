#!/usr/bin/env bash
set -euo pipefail
if (( $# != 0 )); then
    echo '用法：ui/run' >&2
    exit 2
fi
root="$(cd -- "$(dirname -- "$0")/.." && pwd)"
if [[ -z "${GALSCALER_DAEMON:-}" ]]; then
    cargo build --locked --manifest-path "$root/Cargo.toml" --quiet
    export GALSCALER_DAEMON="$root/target/debug/galscalerd"
fi
cd "$root/ui"
exec go run .
